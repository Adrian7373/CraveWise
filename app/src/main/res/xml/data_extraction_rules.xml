<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12+. See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The opt-in recipe photo pack (~30 MB) can be downloaded again; keep it out of the user's cloud quota. -->
        <exclude domain="file" path="recipe_photos/" />
    </cloud-backup>
</data-extraction-rules>
